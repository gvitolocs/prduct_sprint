{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ],
  "rewrites": [
    { "source": "/pathfinder", "destination": "/pathfinder.html" },
    { "source": "/pathfinder/", "destination": "/pathfinder.html" },
    { "source": "/api/submit", "destination": "/api/inbox" },
    { "source": "/api/submissions", "destination": "/api/inbox" }
  ]
}
